FROM python:3.12-slim

# uv is copied from its own published image rather than installed over the
# network, so this layer builds the same way on a host with IPv6-only egress.
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /usr/local/bin/

WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1

COPY router/pyproject.toml router/uv.lock ./
RUN uv sync --locked --no-dev

COPY router/jev_router ./jev_router

EXPOSE 9090
CMD ["uv", "run", "--no-sync", "python", "-m", "jev_router"]
