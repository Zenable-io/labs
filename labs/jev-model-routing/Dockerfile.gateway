# Copyright (c) 2026 Zenable, Inc. v1.6.0-alpha.1, not the v1.5.0 stable release. A CEL-conditioned ExtProc
# policy on v1.5.0 makes the model router read a stale buffered body, so the
# `model` this router rewrites is ignored and the request 404s with
# `model_not_found` (upstream issue #3287, fixed by PR #3321 on 2026-09-03,
# after v1.5.0 shipped on 2026-08-27).
#
# The upstream image is distroless: no shell, no curl, no probe of any kind, so
# `docker compose up --wait` has nothing to health-check the gateway with and a
# restart returns before the new config is actually serving. Copy one static
# busybox in and point a HEALTHCHECK at the gateway's own admin API. The admin
# port is separate from the LLM proxy, so these probes never appear in the
# access log or metrics the exercise reads.
FROM ghcr.io/agentgateway/agentgateway:v1.6.0-alpha.1
COPY --from=busybox:1.36.1-uclibc /bin/busybox /usr/bin/busybox
HEALTHCHECK --interval=2s --timeout=3s --retries=20 --start-period=2s \
  CMD ["/usr/bin/busybox", "wget", "-q", "-O", "-", "http://127.0.0.1:15000/api/config"]
